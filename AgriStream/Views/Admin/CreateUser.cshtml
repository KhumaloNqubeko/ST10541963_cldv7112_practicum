@model CreateUserViewModel
<h1>Create account</h1>
@if (TempData["Success"] is string message) { <p class="alert alert-success">@message</p> }
<form asp-action="CreateUser" method="post" class="col-md-5">
<div asp-validation-summary="All" class="text-danger"></div>
<div class="mb-3"><label asp-for="Username">Username (email address)</label><input asp-for="Username" class="form-control" autocomplete="off" /></div>
<div class="mb-3"><label asp-for="Password"></label><input asp-for="Password" class="form-control" autocomplete="new-password" /><small>At least 12 characters, including uppercase, lowercase, a number and a symbol.</small></div>
<div class="mb-3"><label asp-for="Role"></label><select asp-for="Role" class="form-select">@foreach (var role in AgriStream.Data.SystemRoles.All) { <option value="@role">@role</option> }</select></div>
<button class="btn btn-primary">Create account</button>
</form>
