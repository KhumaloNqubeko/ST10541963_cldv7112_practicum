@if (User.Identity?.IsAuthenticated == true) {
<a class="nav-link" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
<form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" method="post"><button class="btn btn-link">Sign out (@User.Identity.Name)</button></form>
} else { <a class="nav-link" asp-area="Identity" asp-page="/Account/Login">Sign in</a> }
